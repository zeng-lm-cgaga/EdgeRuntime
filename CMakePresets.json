{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "SelfIPCs GCC Debug",
      "description": "Out-of-source SelfIPCs build; src/CMakeLists.txt owns the library sources.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/selfipcs-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "SELFIPCS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "SelfIPCs GCC ASan + UBSan",
      "description": "Sanitized out-of-source SelfIPCs build.",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/selfipcs-asan-ubsan",
      "cacheVariables": {
        "SELFIPCS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "SelfIPCs GCC Release",
      "description": "Release out-of-source SelfIPCs build.",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/selfipcs-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "SELFIPCS_ENABLE_FAILPOINTS": "OFF",
        "SELFIPCS_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "jobs": 2
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
