{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "GCC Debug (out-of-source: build/dev-debug)",
      "description": "Build outside the source tree under ${sourceDir}/build/dev-debug; src/CMakeLists.txt owns the library sources.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "EDGERUNTIME_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "GCC ASan + UBSan (out-of-source: build/asan-ubsan)",
      "description": "Sanitized out-of-source build under ${sourceDir}/build/asan-ubsan; src/CMakeLists.txt owns the library sources.",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "EDGERUNTIME_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "GCC Release (out-of-source: build/release)",
      "description": "Release out-of-source build under ${sourceDir}/build/release; src/CMakeLists.txt owns the library sources.",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "EDGERUNTIME_ENABLE_FAILPOINTS": "OFF",
        "EDGERUNTIME_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "jobs": 2
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
