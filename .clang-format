BasedOnStyle: Google
Standard: c++17
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes: CaseSensitive
# Indentation is one TAB per nesting level (not two spaces). Base indentation
# uses tabs; continuation alignment keeps spaces so multi-line expressions stay
# aligned regardless of the editor's tab width.
IndentWidth: 8
TabWidth: 8
UseTab: ForIndentation
ContinuationIndentWidth: 8
